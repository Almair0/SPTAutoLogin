<Window x:Class="SPTAutoLogin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPT 一键登录"
        Width="440"
        Height="420"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E"
        Icon="icon.ico">
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SPT 账号登录"
                   Foreground="#FFE6E6EC"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <TextBlock Grid.Row="1"
                   Text="启动器位置"
                   Foreground="#FFB4B4C0"
                   FontSize="12"
                   Margin="2,0,0,4" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LauncherPathBox"
                     Grid.Column="0"
                     Height="34"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     FontSize="13"
                     Background="#FF2A2A3C"
                     Foreground="#FFEDEDF2"
                     BorderBrush="#FF44445C"
                     BorderThickness="1"
                     TextWrapping="NoWrap" />
            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="更改"
                    Width="64"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="OnBrowseClick"
                    FontSize="13"
                    Background="#FF3A3A50"
                    Foreground="#FFEDEDF2"
                    BorderBrush="#FF55556E"
                    BorderThickness="1"
                    Cursor="Hand" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="官网用户名"
                   Foreground="#FFB4B4C0"
                   FontSize="12"
                   Margin="2,12,0,4" />

        <TextBox x:Name="UsernameBox"
                 Grid.Row="4"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Padding="8,0"
                 FontSize="14"
                 Background="#FF2A2A3C"
                 Foreground="#FFEDEDF2"
                 BorderBrush="#FF44445C"
                 BorderThickness="1"
                 CaretBrush="#FFEDEDF2" />

        <TextBlock Grid.Row="5"
                   Text="密码"
                   Foreground="#FFB4B4C0"
                   FontSize="12"
                   Margin="2,12,0,4" />

        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="6"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     FontSize="14"
                     Background="#FF2A2A3C"
                     Foreground="#FFEDEDF2"
                     BorderBrush="#FF44445C"
                     BorderThickness="1"
                     CaretBrush="#FFEDEDF2" />

        <CheckBox x:Name="RememberBox"
                  Grid.Row="7"
                  Content="记住账号密码（保存在本机）"
                  Foreground="#FFB4B4C0"
                  VerticalAlignment="Center"
                  Margin="2,10,0,0"
                  Checked="OnRememberChanged"
                  Unchecked="OnRememberChanged" />

        <TextBlock x:Name="RememberStateText"
                   Grid.Row="8"
                   Text=""
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,6,2,0" />

        <StackPanel Grid.Row="9" Orientation="Vertical" Margin="0,10,0,0">
            <Button x:Name="LoginButton"
                    Content="一键登录"
                    Height="38"
                    Click="OnLoginClick"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#FFE0A458"
                    Foreground="#FF221E14"
                    BorderThickness="0"
                    Cursor="Hand" />
            <TextBlock x:Name="StatusText"
                       Text=""
                       Foreground="#FFE0807A"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="2,8,2,0" />
        </StackPanel>
    </Grid>
</Window>
